name: pytorch-bsf
conda_env: environment.yml
entry_points:
  main:
    parameters:
      params: {type: path}
      values: {type: path}
      degree: {type: int}
      save: {type: str, default: "model.bsf"}
    command: >-
      python -m torch_bsf fit --params={params} --values={values}
      --degree={degree} --save={save} --track
  predict:
    parameters:
      model: {type: path}
      params: {type: path}
      save: {type: str, default: "predictions.csv"}
    command: >-
      python -m torch_bsf predict --model={model} --params={params} --save={save}
